# Runtime address book.
# addressbook.pkl is created by the assistant. It holds personal names,
# phone numbers, and birthdays, and a pickle file must be loaded only from
# a trusted source. It is generated data, so Git does not track it.
*.pkl

# Temporary files
*.tmp
*.temp
.cache/
